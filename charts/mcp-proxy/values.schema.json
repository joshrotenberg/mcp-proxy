{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["containerPort", "service", "config"],
  "properties": {
    "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "service": {
      "type": "object",
      "required": ["port", "sessionAffinity", "sessionAffinityTimeoutSeconds"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "sessionAffinity": { "type": "string", "enum": ["None", "ClientIP"] },
        "sessionAffinityTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "config": { "type": "string" },
    "podAnnotations": {
      "type": "object",
      "propertyNames": {
        "not": { "enum": ["checksum/config", "checksum/secret"] }
      }
    }
  }
}
